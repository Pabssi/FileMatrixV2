@{
    ViewData["Title"] = "Security Settings";
    bool hasPassword = ViewBag.HasPassword ?? false;
    bool twoFactorEnabled = ViewBag.TwoFactorEnabled ?? false;
}

<div class="container-fluid py-4">
    <div class="mb-5 reveal-on-scroll">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-indigo text-decoration-none fw-bold small">Settings</a></li>
                <li class="breadcrumb-item active fw-bold text-muted small" aria-current="page">Login & Security</li>
            </ol>
        </nav>
        <h2 class="fw-extrabold text-dark mb-1">Login & Security</h2>
        <p class="text-muted fw-medium">Manage your password, Two-Factor Authentication, and account security.</p>
    </div>

    <div class="row g-4 reveal-on-scroll">
        <div class="col-xl-8">
            <!-- Password Management Card -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden premium-card mb-4 transition-all">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <div class="icon-box-sm bg-warning-subtle text-warning rounded-3 mt-n1">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        </div>
                        <h5 class="fw-bold mb-0">Change Password</h5>
                    </div>
                </div>
                <div class="card-body p-4">
                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted small text-uppercase ls-wide">Current Password</label>
                            <input type="password" name="oldPassword" class="form-control premium-form-control py-3 rounded-3" required placeholder="••••••••">
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted small text-uppercase ls-wide">New Password</label>
                                <input type="password" name="newPassword" class="form-control premium-form-control py-3 rounded-3" required placeholder="Minimum 8 characters">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted small text-uppercase ls-wide">Confirm New Password</label>
                                <input type="password" name="confirmPassword" class="form-control premium-form-control py-3 rounded-3" required placeholder="Repeat new password">
                            </div>
                        </div>
                        <div class="mt-5 pt-4 border-top">
                            <button type="submit" class="btn btn-warning text-dark fw-bold rounded-pill px-5 py-2 shadow-sm border-0">
                                Update Password
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- 2FA Management Card -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden premium-card transition-all">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <div class="icon-box-sm bg-indigo-subtle text-indigo rounded-3 mt-n1">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                        </div>
                        <h5 class="fw-bold mb-0">Two-Factor Authentication (2FA)</h5>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-light rounded-4">
                        <div>
                            <p class="mb-1 fw-bold text-dark">Extra Security Layer</p>
                            <p class="text-muted small mb-0">Protect your account with an additional verification step during login.</p>
                        </div>
                        <div class="text-end">
                            <span class="badge @(twoFactorEnabled ? "bg-success" : "bg-slate-subtle text-slate") rounded-pill px-3 py-2 fw-bold">
                                @(twoFactorEnabled ? "ACTIVE" : "DISABLED")
                            </span>
                        </div>
                    </div>

                    <form asp-action="ToggleTwoFactor" method="post" id="toggle2FAForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="enabled" value="@((!twoFactorEnabled).ToString().ToLower())" />
                        <button type="submit" class="btn @(twoFactorEnabled ? "btn-outline-danger" : "btn-indigo-gradient text-white") rounded-pill px-5 fw-bold py-2 shadow-sm border-0">
                            @(twoFactorEnabled ? "Disable 2FA" : "Enable 2FA")
                        </button>
                    </form>

                    <div class="mt-4 alert alert-premium-indigo border-0 rounded-4 shadow-sm">
                        <div class="d-flex gap-3">
                            <div class="mt-1 text-indigo">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-indigo">Security Note</h6>
                                <p class="mb-0 small text-muted fw-medium lh-base">We highly recommend enabling 2FA to protect your sensitive documents and organization data from unauthorized access.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <!-- Security Audit Card -->
            <div class="card border-0 shadow-sm rounded-4 premium-card mb-4 transition-all">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-4 text-uppercase small text-muted ls-wide">Recent Activity</h6>
                    <div class="d-flex gap-3 mb-4">
                        <div class="icon-box-xs bg-light text-muted rounded-circle">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        </div>
                        <div>
                            <p class="small fw-bold text-dark mb-0">Last Password Change</p>
                            <p class="text-muted x-small mb-0">Never</p>
                        </div>
                    </div>
                    <div class="d-flex gap-3">
                        <div class="icon-box-xs bg-light text-muted rounded-circle">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                        </div>
                        <div>
                            <p class="small fw-bold text-dark mb-0">Last Login Audit</p>
                            <p class="text-muted x-small mb-0">@DateTime.Now.ToString("dd MMM yyyy, HH:mm")</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sessions Card -->
            <div class="card border-0 shadow-sm rounded-4 premium-card transition-all">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-4 text-uppercase small text-muted ls-wide">Active Sessions</h6>
                    <div class="d-flex align-items-center mb-1">
                        <div class="pulse-green me-2"></div>
                        <span class="small fw-bold text-dark">Current Browsing Session</span>
                    </div>
                    <p class="text-muted x-small ms-3 mb-0">Windows • Chrome • IP: 127.0.0.1</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-extrabold { font-weight: 800; }
    .ls-wide { letter-spacing: 0.05em; }
    .x-small { font-size: 0.75rem; }
    
    .premium-card {
        background: #ffffff;
        border: 1px solid #e2e8f0 !important;
    }

    .premium-card:hover {
        border-color: #c7d2fe !important;
    }

    .premium-form-control {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        transition: all 0.2s ease;
    }

    .premium-form-control:focus {
        background-color: #ffffff;
        border-color: #6366f1;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
    }

    .icon-box-sm {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .icon-box-xs {
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .btn-indigo-gradient {
        background: linear-gradient(135deg, #4f46e5, #6366f1);
        transition: all 0.3s ease;
    }

    .btn-indigo-gradient:hover {
        background: linear-gradient(135deg, #4338ca, #4f46e5);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
    }

    .alert-premium-indigo {
        background: rgba(79, 70, 229, 0.04);
        border: 1px solid rgba(79, 70, 229, 0.1) !important;
    }

    .pulse-green {
        width: 8px;
        height: 8px;
        background: #10b981;
        border-radius: 50%;
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
        animation: pulse-green 2s infinite;
    }

    @@keyframes pulse-green {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    .bg-indigo-subtle { background-color: rgba(79, 70, 229, 0.08) !important; }
    .text-indigo { color: #4f46e5 !important; }
    .bg-warning-subtle { background-color: rgba(245, 158, 11, 0.08) !important; }
    .text-warning { color: #f59e0b !important; }
    .bg-slate-subtle { background-color: #f1f5f9 !important; }
    .text-slate { color: #64748b !important; }
    
    .transition-all {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
</style>
