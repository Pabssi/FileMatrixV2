@{
    ViewData["Title"] = "Get Started - Workspaces";
    var userName = User?.Identity?.Name ?? "Admin User";
}

<div class="workspace-hero">
    <div class="container py-5 py-md-6">
        <div class="text-center mb-5">
            <div class="workspace-logo-card mb-3">
                <div class="workspace-logo-inner"></div>
            </div>
            <h1 class="workspace-brand mb-1">FileMatrix</h1>
            <p class="workspace-greeting mb-1">Welcome, @userName!</p>
            <p class="workspace-subtitle">Let's set up your workspace to get started</p>
        </div>

        <div class="row g-4 justify-content-center">
            <div class="col-md-5">
                <div class="workspace-card h-100">
                    <div class="workspace-card-icon workspace-card-icon-primary">
                        <span class="workspace-card-icon-glyph">
                            <!-- simple building icon style -->
                            <span class="workspace-card-icon-bar"></span>
                            <span class="workspace-card-icon-bar"></span>
                            <span class="workspace-card-icon-bar"></span>
                        </span>
                    </div>
                    <h3 class="workspace-card-title">Create Workspace</h3>
                    <p class="workspace-card-text">
                        Set up a new workspace for your business, team, or personal use. You'll have full control.
                    </p>
                    <a class="workspace-card-link" asp-action="Create">
                        Get Started
                        <span class="workspace-card-link-arrow">&rarr;</span>
                    </a>
                    <hr class="workspace-card-separator" />
                    <ul class="workspace-card-benefits">
                        <li><span class="workspace-check"></span>Full administrative access</li>
                        <li><span class="workspace-check"></span>Invite team members</li>
                        <li><span class="workspace-check"></span>Customize settings</li>
                    </ul>
                </div>
            </div>
            <div class="col-md-5">
                <div class="workspace-card h-100">
                    <div class="workspace-card-icon workspace-card-icon-secondary">
                        <span class="workspace-card-icon-glyph workspace-card-icon-glyph-users"></span>
                    </div>
                    <h3 class="workspace-card-title">Join Workspace</h3>
                    <p class="workspace-card-text">
                        Have an invite code? Join an existing workspace and collaborate with your team.
                    </p>
                    <a class="workspace-card-link" asp-action="Join">
                        Join Now
                        <span class="workspace-card-link-arrow">&rarr;</span>
                    </a>
                    <hr class="workspace-card-separator" />
                    <ul class="workspace-card-benefits">
                        <li><span class="workspace-check"></span>Quick access to team documents</li>
                        <li><span class="workspace-check"></span>Seamless collaboration</li>
                        <li><span class="workspace-check"></span>Instant connectivity</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .workspace-hero {
        min-height: calc(100vh - 80px);
        background: radial-gradient(circle at top left, #e0e7ff 0, #f9f5ff 30%, #fdf2ff 55%, #f9fafb 100%);
        display: flex;
        align-items: flex-start;
    }

    .workspace-logo-card {
        width: 70px;
        height: 70px;
        border-radius: 22px;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow:
            0 18px 50px rgba(88, 28, 135, 0.35),
            0 4px 12px rgba(30, 64, 175, 0.25);
        margin-left: auto;
        margin-right: auto;
    }

    .workspace-logo-inner {
        width: 40px;
        height: 40px;
        border-radius: 14px;
        background: linear-gradient(135deg, #4f46e5, #a855f7);
    }

    .workspace-brand {
        font-size: 1.9rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        background: linear-gradient(90deg, #4f46e5, #a855f7);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .workspace-greeting {
        font-weight: 500;
        color: #020617;
    }

    .workspace-greeting span {
        color: #4f46e5;
    }

    .workspace-subtitle {
        color: #6b7280;
        font-size: 0.98rem;
    }

    .workspace-card {
        background: #ffffff;
        border-radius: 26px;
        padding: 1.9rem 1.9rem 1.7rem;
        box-shadow:
            0 22px 60px rgba(15, 23, 42, 0.14),
            0 4px 12px rgba(15, 23, 42, 0.05);
    }

    .workspace-card-icon {
        width: 52px;
        height: 52px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.2rem;
        color: #ffffff;
    }

    .workspace-card-icon-primary {
        background: linear-gradient(135deg, #4f46e5, #6366f1);
    }

    .workspace-card-icon-secondary {
        background: linear-gradient(135deg, #a855f7, #ec4899);
    }

    .workspace-card-title {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 0.4rem;
    }

    .workspace-card-text {
        color: #6b7280;
        font-size: 0.95rem;
        margin-bottom: 1.2rem;
    }

    .workspace-card-link {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        color: #4f46e5;
        font-weight: 600;
        text-decoration: none;
        font-size: 0.95rem;
    }

    .workspace-card-link-arrow {
        font-size: 1.05rem;
    }

    .workspace-card-link:hover {
        text-decoration: underline;
    }

    .workspace-card-separator {
        margin: 1.4rem 0 1rem;
        border-top: 1px solid rgba(148, 163, 184, 0.25);
    }

    .workspace-card-benefits {
        list-style: none;
        padding-left: 0;
        margin: 0;
        font-size: 0.9rem;
        color: #4b5563;
    }

    .workspace-card-benefits li + li {
        margin-top: 0.35rem;
    }

    .workspace-check {
        display: inline-flex;
        width: 18px;
        height: 18px;
        border-radius: 999px;
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.7);
        margin-right: 0.45rem;
        position: relative;
        top: 3px;
    }

    .workspace-check::before {
        content: '';
        position: absolute;
        left: 4px;
        top: 2px;
        width: 7px;
        height: 11px;
        border-right: 2px solid #10b981;
        border-bottom: 2px solid #10b981;
        transform: rotate(40deg);
    }

    .workspace-card-icon-glyph {
        display: inline-flex;
        gap: 3px;
    }

    .workspace-card-icon-bar {
        width: 4px;
        height: 16px;
        border-radius: 999px;
        background-color: rgba(255, 255, 255, 0.9);
    }

    .workspace-card-icon-glyph-users::before,
    .workspace-card-icon-glyph-users::after {
        content: '';
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 999px;
        border: 2px solid rgba(255, 255, 255, 0.9);
        margin: 0 1px;
    }

    @@media (max-width: 767.98px) {
        .workspace-hero {
            min-height: auto;
        }

        .workspace-card {
            border-radius: 22px;
        }
    }
</style>
